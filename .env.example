# Copia este archivo como .env y completa tus credenciales.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=-1002160464787
TELEGRAM_SESSION=data/telegram

# demo o production. Las claves de un entorno no funcionan en el otro.
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_COMBO_COLLECTION=KXMVECROSSCATEGORY-R

# true: interpreta y registra, pero no envía órdenes a Kalshi.
DRY_RUN=true
# Para production con DRY_RUN=false debe valer exactamente YES.
ALLOW_LIVE_TRADING=NO

# stake 10 invertirá como máximo 10 * STAKE_UNIT_USD.
STAKE_UNIT_USD=1.00
MAX_CONTRACTS_PER_ORDER=100
MAX_NOTIONAL_PER_ORDER_USD=100.00
# Vacío permite cualquier ticker; separa varios con comas.
ALLOWED_TICKERS=

DATABASE_PATH=data/orders.db
